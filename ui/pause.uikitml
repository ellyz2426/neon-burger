<panel width="360" height="280" backgroundColor="#000a18" backgroundOpacity="0.95" borderRadius="12" borderColor="#ffcc00" borderWidth="2" flexDirection="column" alignItems="center" padding="20" gap="12">
  <text content="PAUSED" fontSize="28" fontWeight="bold" color="#ffcc00" marginBottom="8"/>
  <text content="Game paused - take a break!" fontSize="11" color="#88aa66"/>
  <panel id="btn-resume" width="240" height="44" backgroundColor="#00ffcc" borderRadius="6" alignItems="center" justifyContent="center" cursor="pointer" marginTop="8">
    <text content="RESUME" fontSize="16" fontWeight="bold" color="#001a0a"/>
  </panel>
  <panel id="btn-quit" width="240" height="44" backgroundColor="#ff4444" borderRadius="6" alignItems="center" justifyContent="center" cursor="pointer">
    <text content="QUIT TO MENU" fontSize="14" fontWeight="bold" color="#1a0000"/>
  </panel>
</panel>
