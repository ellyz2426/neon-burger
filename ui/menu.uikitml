<panel width="400" height="460" background-color="#000a18" background-opacity="0.95" border-radius="12" border-color="#00ffcc" border-width="2" flex-direction="column" align-items="center" padding="20" gap="10">
  <div font-size="32" font-weight="bold" color="#00ffcc" margin-bottom="2">NEON BURGER</div>
  <div font-size="16" color="#ffcc00" margin-bottom="12">VR</div>
  <panel id="btn-arcade" width="280" height="48" background-color="#00ffcc" border-radius="6" align-items="center" justify-content="center" cursor="pointer">
    <div font-size="18" font-weight="bold" color="#001a0a">ARCADE MODE</div>
  </panel>
  <panel id="btn-speed" width="280" height="44" background-color="#004433" border-radius="6" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
    <div font-size="15" color="#00ffcc">SPEED RUN</div>
  </panel>
  <panel id="btn-zen" width="280" height="44" background-color="#004433" border-radius="6" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
    <div font-size="15" color="#00ffcc">ZEN MODE</div>
  </panel>
  <panel id="btn-challenge" width="280" height="44" background-color="#004433" border-radius="6" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
    <div font-size="15" color="#00ffcc">CHALLENGE</div>
  </panel>
  <panel width="280" flex-direction="row" justify-content="space-between" gap="8" margin-top="4">
    <panel id="btn-tutorial" width="132" height="38" background-color="#001a0a" border-radius="4" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
      <div font-size="11" color="#00ffcc">HOW TO PLAY</div>
    </panel>
    <panel id="btn-settings" width="132" height="38" background-color="#001a0a" border-radius="4" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
      <div font-size="11" color="#00ffcc">SETTINGS</div>
    </panel>
  </panel>
  <panel width="280" flex-direction="row" justify-content="space-between" gap="8">
    <panel id="btn-stats" width="132" height="38" background-color="#001a0a" border-radius="4" border-color="#cc88ff" border-width="1" align-items="center" justify-content="center" cursor="pointer">
      <div font-size="11" color="#cc88ff">STATISTICS</div>
    </panel>
    <panel id="btn-achv" width="132" height="38" background-color="#001a0a" border-radius="4" border-color="#ffcc00" border-width="1" align-items="center" justify-content="center" cursor="pointer">
      <div font-size="11" color="#ffcc00">ACHIEVEMENTS</div>
    </panel>
  </panel>
</panel>
