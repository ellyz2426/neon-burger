<panel width="380" height="440" background-color="#000a18" background-opacity="0.95" border-radius="12" border-color="#cc88ff" border-width="2" flex-direction="column" align-items="center" padding="20" gap="8">
  <div font-size="24" font-weight="bold" color="#cc88ff" margin-bottom="8">STATISTICS</div>
  <div id="stat-games" font-size="14" color="#ffffff">GAMES PLAYED: 0</div>
  <div id="stat-high" font-size="14" color="#ffcc00">HIGH SCORE: 0</div>
  <div id="stat-total" font-size="14" color="#ffffff">TOTAL SCORE: 0</div>
  <div id="stat-burgers" font-size="14" color="#ff8800">BURGERS COMPLETED: 0</div>
  <div id="stat-enemies" font-size="14" color="#cc88ff">ENEMIES STUNNED: 0</div>
  <div id="stat-maxlevel" font-size="14" color="#ffffff">BEST LEVEL: 0</div>
  <div id="stat-maxcombo" font-size="14" color="#ffffff">BEST COMBO: 0x</div>
  <div id="stat-time" font-size="14" color="#ffffff">TOTAL TIME: 0m</div>
  <panel id="btn-stats-back" width="240" height="40" background-color="#001a0a" border-radius="6" border-color="#cc88ff" border-width="1" align-items="center" justify-content="center" cursor="pointer" margin-top="12">
    <div font-size="14" color="#cc88ff">BACK</div>
  </panel>
</panel>
