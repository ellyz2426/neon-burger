<panel width="400" height="460" backgroundColor="#000a18" backgroundOpacity="0.95" borderRadius="12" borderColor="#ffcc00" borderWidth="2" flexDirection="column" alignItems="center" padding="16" gap="4">
  <text content="ACHIEVEMENTS" fontSize="24" fontWeight="bold" color="#ffcc00" marginBottom="4"/>
  <text id="achv-count" content="0 / 20" fontSize="12" color="#88ccaa" marginBottom="6"/>
  <panel width="360" backgroundColor="#001a0a" borderRadius="6" padding="8" flexDirection="column" gap="4">
    <text id="achv-0" content="[ ] First Burger - Complete your first burger" fontSize="9" color="#88ccaa"/>
    <text id="achv-1" content="[ ] Hot Streak - Get a 3x combo" fontSize="9" color="#88ccaa"/>
    <text id="achv-2" content="[ ] Crusher - Crush an enemy with an ingredient" fontSize="9" color="#88ccaa"/>
    <text id="achv-3" content="[ ] Pepper Pro - Stun 10 enemies total" fontSize="9" color="#88ccaa"/>
    <text id="achv-4" content="[ ] Level 5 - Reach level 5" fontSize="9" color="#88ccaa"/>
    <text id="achv-5" content="[ ] Score 10K - Score 10000 points" fontSize="9" color="#88ccaa"/>
    <text id="achv-6" content="[ ] Speed Demon - Complete speed run mode" fontSize="9" color="#88ccaa"/>
    <text id="achv-7" content="[ ] Zen Master - Play 5 zen mode games" fontSize="9" color="#88ccaa"/>
    <text id="achv-8" content="[ ] No Deaths - Complete a level without dying" fontSize="9" color="#88ccaa"/>
    <text id="achv-9" content="[ ] Burger King - Make 50 burgers total" fontSize="9" color="#88ccaa"/>
  </panel>
  <panel id="btn-achv-back" width="200" height="36" backgroundColor="#001a0a" borderRadius="4" borderColor="#ffcc00" borderWidth="1" alignItems="center" justifyContent="center" cursor="pointer" marginTop="8">
    <text content="BACK" fontSize="12" color="#ffcc00"/>
  </panel>
</panel>
