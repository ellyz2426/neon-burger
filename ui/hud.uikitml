<panel width="600" height="60" background-color="#000a18" background-opacity="0.8" border-radius="8" border-color="#00ffcc" border-width="1" flex-direction="row" align-items="center" justify-content="space-between" padding="8">
  <div id="hud-score" font-size="14" font-weight="bold" color="#00ffcc">SCORE: 0</div>
  <div id="hud-level" font-size="14" color="#ffcc00">LEVEL 1</div>
  <div id="hud-lives" font-size="14" color="#ff4444">LIVES: 3</div>
  <div id="hud-pepper" font-size="14" color="#ff8800">PEPPER: 3</div>
  <div id="hud-combo" font-size="14" font-weight="bold" color="#cc88ff"></div>
  <div id="hud-timer" font-size="14" color="#ffffff"></div>
</panel>
