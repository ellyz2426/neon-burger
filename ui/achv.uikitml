<panel width="420" height="500" background-color="#000a18" background-opacity="0.95" border-radius="12" border-color="#ffcc00" border-width="2" flex-direction="column" align-items="center" padding="16" gap="4">
  <div font-size="24" font-weight="bold" color="#ffcc00" margin-bottom="6">ACHIEVEMENTS</div>
  <panel width="380" flex-direction="column" gap="4" overflow-y="scroll" flex-grow="1">
    <panel width="370" flex-direction="row" justify-content="space-between" align-items="center" padding="4" background-color="#001a0a" border-radius="4">
      <panel flex-direction="column" gap="1">
        <div id="achv-0-name" font-size="11" font-weight="bold" color="#ffcc00">First Steps</div>
        <div id="achv-0-desc" font-size="9" color="#888888">Complete your first burger</div>
      </panel>
      <div id="achv-0-status" font-size="9" color="#00ffcc">[LOCKED]</div>
    </panel>
    <panel width="370" flex-direction="row" justify-content="space-between" align-items="center" padding="4" background-color="#001a0a" border-radius="4">
      <panel flex-direction="column" gap="1">
        <div id="achv-1-name" font-size="11" font-weight="bold" color="#ffcc00">Pepper Pro</div>
        <div id="achv-1-desc" font-size="9" color="#888888">Stun 10 enemies</div>
      </panel>
      <div id="achv-1-status" font-size="9" color="#00ffcc">[LOCKED]</div>
    </panel>
    <panel width="370" flex-direction="row" justify-content="space-between" align-items="center" padding="4" background-color="#001a0a" border-radius="4">
      <panel flex-direction="column" gap="1">
        <div id="achv-2-name" font-size="11" font-weight="bold" color="#ffcc00">Combo King</div>
        <div id="achv-2-desc" font-size="9" color="#888888">Get a 5x combo</div>
      </panel>
      <div id="achv-2-status" font-size="9" color="#00ffcc">[LOCKED]</div>
    </panel>
    <panel width="370" flex-direction="row" justify-content="space-between" align-items="center" padding="4" background-color="#001a0a" border-radius="4">
      <panel flex-direction="column" gap="1">
        <div id="achv-3-name" font-size="11" font-weight="bold" color="#ffcc00">Level 5</div>
        <div id="achv-3-desc" font-size="9" color="#888888">Reach level 5</div>
      </panel>
      <div id="achv-3-status" font-size="9" color="#00ffcc">[LOCKED]</div>
    </panel>
    <panel width="370" flex-direction="row" justify-content="space-between" align-items="center" padding="4" background-color="#001a0a" border-radius="4">
      <panel flex-direction="column" gap="1">
        <div id="achv-4-name" font-size="11" font-weight="bold" color="#ffcc00">Speed Demon</div>
        <div id="achv-4-desc" font-size="9" color="#888888">Win Speed Run mode</div>
      </panel>
      <div id="achv-4-status" font-size="9" color="#00ffcc">[LOCKED]</div>
    </panel>
  </panel>
  <panel id="btn-achv-back" width="240" height="36" background-color="#001a0a" border-radius="6" border-color="#ffcc00" border-width="1" align-items="center" justify-content="center" cursor="pointer" margin-top="6">
    <div font-size="14" color="#ffcc00">BACK</div>
  </panel>
</panel>
