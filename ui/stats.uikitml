<panel width="400" height="420" backgroundColor="#000a18" backgroundOpacity="0.95" borderRadius="12" borderColor="#cc88ff" borderWidth="2" flexDirection="column" alignItems="center" padding="16" gap="6">
  <text content="STATISTICS" fontSize="24" fontWeight="bold" color="#cc88ff" marginBottom="8"/>
  <panel width="360" backgroundColor="#001a0a" borderRadius="6" padding="10" flexDirection="column" gap="6">
    <text id="stat-games" content="Games Played: 0" fontSize="12" color="#88ccaa"/>
    <text id="stat-score" content="Total Score: 0" fontSize="12" color="#88ccaa"/>
    <text id="stat-best" content="Best Score: 0" fontSize="12" color="#ffcc00"/>
    <text id="stat-level" content="Best Level: 0" fontSize="12" color="#88ccaa"/>
    <text id="stat-burgers" content="Burgers Made: 0" fontSize="12" color="#00ffcc"/>
    <text id="stat-crush" content="Enemies Crushed: 0" fontSize="12" color="#ff4444"/>
    <text id="stat-pepper" content="Peppers Used: 0" fontSize="12" color="#ffcc00"/>
    <text id="stat-deaths" content="Deaths: 0" fontSize="12" color="#ff8888"/>
  </panel>
  <panel id="btn-stats-back" width="200" height="36" backgroundColor="#001a0a" borderRadius="4" borderColor="#cc88ff" borderWidth="1" alignItems="center" justifyContent="center" cursor="pointer" marginTop="12">
    <text content="BACK" fontSize="12" color="#cc88ff"/>
  </panel>
</panel>
