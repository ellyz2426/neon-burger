<panel width="360" height="360" background-color="#000a18" background-opacity="0.95" border-radius="12" border-color="#00ffcc" border-width="2" flex-direction="column" align-items="center" padding="20" gap="10">
  <div font-size="24" font-weight="bold" color="#00ffcc" margin-bottom="8">SETTINGS</div>
  <panel width="280" flex-direction="row" justify-content="space-between" align-items="center" padding="4">
    <div font-size="14" color="#ffffff">SOUND EFFECTS</div>
    <panel id="btn-sfx-toggle" width="60" height="32" background-color="#004433" border-radius="4" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
      <div id="sfx-status" font-size="12" font-weight="bold" color="#00ffcc">ON</div>
    </panel>
  </panel>
  <panel width="280" flex-direction="row" justify-content="space-between" align-items="center" padding="4">
    <div font-size="14" color="#ffffff">MUSIC</div>
    <panel id="btn-music-toggle" width="60" height="32" background-color="#004433" border-radius="4" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer">
      <div id="music-status" font-size="12" font-weight="bold" color="#00ffcc">ON</div>
    </panel>
  </panel>
  <panel width="280" flex-direction="row" justify-content="space-between" align-items="center" padding="4">
    <div font-size="14" color="#ffffff">DIFFICULTY</div>
    <div font-size="14" color="#ffcc00">NORMAL</div>
  </panel>
  <panel id="btn-settings-back" width="240" height="40" background-color="#004433" border-radius="6" border-color="#00ffcc" border-width="1" align-items="center" justify-content="center" cursor="pointer" margin-top="12">
    <div font-size="14" color="#00ffcc">BACK</div>
  </panel>
</panel>
